  // =======================================================================
  // 第18天：身份巩固 — 未来的你
  // =======================================================================
  DAYS[18] = {
    phase: '身份巩固',
    title: '未来的你',
    greeting: '早上好！今天咱们做一个"心灵实验"——闭上眼睛，想象未来的你。\n\n不要觉得可笑。飞行员在飞行前会在脑子里"飞"一遍整个航线；运动员比赛前会在脑子里"跑"一遍整个赛道。你的大脑分不清"真实经历"和"生动想象"——你想象得越具体，你的大脑就越觉得"这件事已经发生过了"，做起来就越容易。\n\n好，现在找一个舒服的姿势——坐着、靠着都行。闭上眼睛。想象21天后的你——也就是几天后的你。那时候你已经完成了整个21天计划。你看起来怎么样？\n\n你的眼睛是不是更亮了？你的皮肤是不是更干净了？你说话的声音是不是更有底气了？你早上起来的时候是不是不咳了？你吃完饭是不是不急着找烟了？你晚上睡觉前是不是不看手机了？\n\n你再想象一下——你坐在家里，你的家人看着你的眼神。你孩子说"爸，你最近气色真好"。你老伴靠在你肩膀上，没说话，但你知道他/她心里踏实了。\n\n这就是"未来的你"。他不远——就在几天后。你今天做的每一个选择，都在让他变成现实。就像一棵树——它的未来早就藏在种子里了。你的未来也早就藏在你的选择里了。\n\n睁开眼睛。你看到那个未来的你了吗？他/她在对你笑。因为他/她知道——你正在走来。',
    challenge: '找一个安静的地方，闭上眼睛2分钟。想象"21天后的你"——你的样子、你的感觉、你的家人看你的眼神。越具体越好。然后睁开眼睛，写下一句话描述那个"未来的你"。',
    report: {
      question: '你看到了未来的你吗？用一句话描述一下。',
      options: [
        { text: '🌟 看到了，感觉很真实', next: 'good', effect: 'XS.addCheckin({success:true, day:18})' },
        { text: '😊 看到了一些，但有点模糊', next: 'ok', effect: 'XS.addCheckin({success:false, day:18})' },
        { text: '😅 想想象但静不下来', next: 'miss', effect: 'XS.addCheckin({success:false, day:18})' }
      ]
    },
    followups: {
      good: {
        coach: '太好了！你能清晰地看到"未来的你"——这证明你已经从"现在的自己"走向了"想要的自己"。那个"未来的你"不是幻想，他是一个已经存在的可能性。就像一颗种子，它里面已经包含了整棵树的形状。你每天给这颗种子浇水——你的每一个好习惯、每一次替代、每一次坚持——都是在让树长大。你用你的眼睛，看到了你未来的样子。现在你需要做的，就是一步一步走向那个你看到的人。他/她不完美——但你看到他/她在笑。因为他/她知道自己走在正确的路上。记住那个感觉。当你遇到困难的时候，闭上眼睛再看他/她一眼。',
        options: []
      },
      ok: {
        coach: '有点模糊是正常的——因为你还没真正到达那里。但你看到了一些东西，对吧？也许是你气色好的样子，也许是家人欣慰的眼神，也许是你自己轻松的感觉。那些碎片是真实的——它们是你未来的碎片。随着你一天一天往前走，那些碎片会越来越清晰，最后拼成一幅完整的画面。就像一个画家——一开始只有几笔，画着画着，人就出来了。你在画你自己，一笔一笔。今天你画了一笔，明天再画一笔。到21天的时候，你看看——你画出了什么？',
        options: []
      },
      miss: {
        coach: '静不下来？那你今天心里是不是有什么事？心乱了，就看不到远方。没关系——你先深呼吸三次，把今天的事放下。然后我告诉你一个更简单的方法——你不用"看"未来的你，你"听"也行。你闭上眼睛，听听看——21天后，你早上起来，是不是不咳嗽了？周围是不是安静的？你心里是不是没那么堵了？能听到一点吗？哪怕只听到了"安静"两个字，那也是你的未来在跟你说话。明天再试一次。未来已经在敲门了，你只要静下来就能听见。',
        options: []
      }
    }
  };

  // =======================================================================
  // 第19天：身份巩固 — 感恩身体
  // =======================================================================
  DAYS[19] = {
    phase: '身份巩固',
    title: '感恩身体',
    greeting: '早上好！今天咱们说一个很少人说的话题——感恩你的身体。\n\n你想想——你的身体为你工作了这么多年。从你出生到现在，几十年了，它从来没有请过假，从来没有罢工过。你让它走路，它就走路；你让它扛东西，它就扛东西；你让它熬夜，它就陪你熬夜。你抽烟的时候，它帮你过滤；你喝酒的时候，它帮你解毒；你刷手机的时候，它帮你睁着眼睛、帮你坐着。\n\n它从来没有抱怨过。它只是默默承受——直到有一天，它撑不住了，才会给你一个信号。那个信号可能是咳嗽、可能是头疼、可能是失眠、可能是高血压。这些不是你的身体在"惩罚"你——是它在"求救"：我真的累了，你对我好一点行不行？\n\n今天咱们不挑战、不替代、不观察。今天咱们做一件很简单的事——为你的身体做一件好事。可以是一件很小的事：\n- 喝一杯温水（而不是浓茶或酒）\n- 做一个简单的伸展（转转脖子、伸伸腰）\n- 早半个小时上床\n- 用热水泡个脚\n- 出门晒10分钟太阳\n- 吃一顿少油少盐的饭\n\n选一件。不为别人、不为健康、不为改变习惯——只是为了谢谢你自己的身体。你对它说一声：辛苦了，今天我好好对你。',
    challenge: '今天为你的身体做一件好事。不用大，一件小事就行——喝一杯温水、伸个懒腰、泡个脚、早睡半小时、晒晒太阳。做的时候在心里对你的身体说一句："辛苦了，谢谢你。"',
    report: {
      question: '今天为身体做了什么好事？',
