})

// ─── EVENT BINDING ───
function updateBadge(){
  var state=XS.getState()
  var day=XS.getDay()
  if(day===0&&!state.onboardingComplete)$('h-badge').textContent='新朋友'
  else if(day<=21)$('h-badge').textContent='第'+(day+1)+'天'
  else $('h-badge').textContent='完成'
}

function initUI(){
  updateBadge()
  // TTS
  var ttsState=XS.getState().ttsEnabled!==false
  setTTSState(ttsState)
  if($('tts-btn'))$('tts-btn').onclick=function(){setTTSState(!ttsEnabled)}
  // Header emergency
  if($('h-action'))$('h-action').onclick=function(){switchView('emergency')}
  // Bottom nav
  var navs=document.querySelectorAll('.nav-btn')
  for(var i=0;i<navs.length;i++){
    navs[i].onclick=function(){
      var name=this.dataset.page.replace('page-','')
      switchView(name)
    }
  }
  // Dashboard
  if($('d-session-btn'))$('d-session-btn').onclick=function(){switchView('chat')}
  if($('d-emergency-btn'))$('d-emergency-btn').onclick=function(){switchView('emergency')}
  if($('d-settings-btn'))$('d-settings-btn').onclick=function(){switchView('settings')}
  // Settings
  if($('s-tts-toggle'))$('s-tts-toggle').onclick=function(){
    var state=XS.getState()
    setTTSState(state.ttsEnabled===false)
  }
  if($('s-guardian-btn'))$('s-guardian-btn').onclick=function(){
    var name=prompt('输入守护人的称呼（如：儿子/女儿）：')
    if(name) XS.setGuardian(name,null)
    showSettings()
  }
  if($('s-reset-btn'))$('s-reset-btn').onclick=function(){
    if(confirm('确定要重新开始吗？所有进度将清空。')){XS.reset();switchView('chat')}
  }
  // Install
  if($('install-accept'))$('install-accept').onclick=function(){
    if(deferredPrompt){deferredPrompt.prompt();deferredPrompt.userChoice.then(function(){deferredPrompt=null;var b=$('install-banner');if(b)b.style.display='none'})}
  }
  if($('install-dismiss'))$('install-dismiss').onclick=function(){var b=$('install-banner');if(b)b.style.display='none'}
  // Hash routing
  window.addEventListener('hashchange',function(){
    var hash=location.hash||''
    if(hash==='#emergency') switchView('emergency')
    else if(hash==='#dashboard') switchView('dashboard')
    else switchView('chat')
  })
  var hash=location.hash||''
  if(hash==='#emergency'){switchView('emergency');return}
  if(hash==='#dashboard'){switchView('dashboard');return}
  switchView('chat')
}

// ─── SW REGISTRATION ───
if('serviceWorker' in navigator){
  window.addEventListener('load',function(){
    navigator.serviceWorker.register('sw.js',{scope:'/xinsheng/'})
  })
}

// ─── EXPOSE SPEAK FOR INLINE USE ───
window.__speak=speak

// ─── START ───
initUI()
scheduleNotifications()
})();
</script>
</body>
</html>
