function showEmergency(){
  var container=$('emerg-container')
  if(!container) return
  container.innerHTML=''
  var title=document.createElement('div')
  title.className='emerg-title'
  title.textContent='🆘 现在你需要什么？'
  container.appendChild(title)
  var sub=document.createElement('div')
  sub.className='emerg-sub'
  sub.textContent='选一个你现在的感受'
  container.appendChild(sub)
  EMERGENCY_ITEMS.forEach(function(item){
    var btn=document.createElement('button')
    btn.className='emerg-btn'
    btn.innerHTML='<span class="emerg-icon">'+item.icon+'</span><div><div class="emerg-label">'+item.label+'</div><div class="emerg-desc">'+item.desc+'</div></div>'
    btn.onclick=function(){startEmergencyTiers(item)}
    container.appendChild(btn)
  })
}

function startEmergencyTiers(item){
  switchView('chat')
  var chat=$('chat-messages')
  chat.innerHTML=''
  var title=document.createElement('div')
  title.className='msg coach'
  title.innerHTML='<p style="font-weight:600;color:var(--accent)">🆘 '+item.icon+' '+item.label+'</p><p style="color:var(--dim);font-size:.8rem">'+item.desc+'</p>'
  chat.appendChild(title)
  showTier(item, 0)
}

function showTier(item, idx){
  var chat=$('chat-messages')
  if(idx>=item.tiers.length){
    var m=document.createElement('div')
    m.className='msg coach'
    m.innerHTML='<p style="color:var(--gold);text-align:center;font-weight:500">✅ 你完成了所有步骤。\n\n记住这个感觉——你靠自己撑过来了。</p>'
    chat.appendChild(m)
    var b=document.createElement('button')
    b.className='btn-second'
    b.textContent='🆘 还需要其他帮助吗？'
    b.onclick=function(){switchView('emergency')}
    chat.appendChild(b)
    var b2=document.createElement('button')
    b2.className='btn-primary'
    b2.textContent='🌱 查看成长'
    b2.onclick=function(){switchView('dashboard')}
    chat.appendChild(b2)
    return
  }
  var tier=item.tiers[idx]
  var dots=document.createElement('div')
  dots.className='typing-indicator'
  dots.innerHTML='<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>'
  chat.appendChild(dots)
  chat.scrollTop=chat.scrollHeight
  setTimeout(function(){
    if(dots.parentNode) dots.remove()
    var m=document.createElement('div')
    m.className='msg coach emerg-step'
    var parts=tier.coach.split('\n\n')
    var html='<p style="color:var(--gold);font-size:.75rem;margin-bottom:.3rem">'+tier.label+'</p>'
    for(var i=0;i<parts.length;i++) html+='<p>'+parts[i].replace(/\n/g,'<br>')+'</p>'
    m.innerHTML=html
    chat.appendChild(m)
    chat.scrollTop=chat.scrollHeight
    if(ttsEnabled) speak(tier.coach)
    setTimeout(function(){
      var btn=document.createElement('button')
      btn.className='option-btn'
      btn.textContent='✅ '+tier.action
      btn.style.textAlign='center'
      btn.onclick=function(){
        btn.disabled=true
        var u=document.createElement('div');u.className='msg user';u.textContent='✅ 完成';chat.appendChild(u)
        chat.scrollTop=chat.scrollHeight
        setTimeout(function(){showTier(item, idx+1)},400)
      }
      chat.appendChild(btn)
      chat.scrollTop=chat.scrollHeight
    },400)
  },600)
}

// ─── DASHBOARD ───
function renderTree(day){
  var svg=$('growth-tree')
  if(!svg) return
  var stages=['M60,150 L60,140 M60,140 Q60,130 55,120 M60,140 Q60,130 65,120 M60,120 L60,100 M60,100 Q60,85 50,75 M60,100 Q60,85 70,75 M60,75 L60,60 M60,60 Q60,50 55,45 M60,60 Q60,50 65,45 M55,45 Q50,38 48,35 M65,45 Q70,38 72,35 M60,45 L60,35 M60,35 Q58,30 56,28 M60,35 Q62,30 64,28 M48,35 Q45,30 43,28 M72,35 Q75,30 77,28']
  var maxStages=stages.length
  var currentStage=Math.min(day, maxStages)
  var lines=''
  for(var i=0;i<Math.min(currentStage, maxStages);i++){
    lines+=stages[i]+' '
  }
  svg.innerHTML=''
  // Ground
  var g=document.createElementNS('http://www.w3.org/2000/svg','ellipse')
  g.setAttribute('cx','60');g.setAttribute('cy','155');g.setAttribute('rx','40');g.setAttribute('ry','6')
  g.setAttribute('fill','#3a4a3a')
  svg.appendChild(g)
  // Tree trunk/branches
  if(lines){
    var trunk=document.createElementNS('http://www.w3.org/2000/svg','path')
    trunk.setAttribute('d',lines.trim())
    trunk.setAttribute('stroke','#5a8a5a');trunk.setAttribute('stroke-width','3');trunk.setAttribute('fill','none')
    trunk.setAttribute('stroke-linecap','round');trunk.setAttribute('stroke-linejoin','round')
    svg.appendChild(trunk)
  }
  // Crown (leaves)
  if(day>=3){
    var crownSize=Math.min(8+day*2,50)
    var crown=document.createElementNS('http://www.w3.org/2000/svg','ellipse')
    crown.setAttribute('cx','60');crown.setAttribute('cy','30')
    crown.setAttribute('rx',String(Math.min(10+day,35)));crown.setAttribute('ry',String(Math.min(8+day/2,28)))
    crown.setAttribute('fill','rgba(78,205,196,'+String(Math.min(0.3+day*0.03,0.9))+')')
    svg.appendChild(crown)
  }
  // Leaves/blooms
  if(day>=7){
    for(var i=0;i<Math.min(day-6,10);i++){
      var dot=document.createElementNS('http://www.w3.org/2000/svg','circle')
      var angle=(i/10)*Math.PI*2
      var r=Math.min(10+day,30)
      var cx=60+Math.cos(angle)*r*0.8
      var cy=30-Math.sin(angle)*r*0.6
      dot.setAttribute('cx',String(cx));dot.setAttribute('cy',String(cy))
      dot.setAttribute('r','3')
      dot.setAttribute('fill','#ffd93d')
      svg.appendChild(dot)
    }
  }
  // Day label
  var txt=document.createElementNS('http://www.w3.org/2000/svg','text')
  txt.setAttribute('x','60');txt.setAttribute('y','170')
  txt.setAttribute('text-anchor','middle')
  txt.setAttribute('fill','var(--dim)')
  txt.setAttribute('font-size','10')
  txt.textContent='第 '+day+' 天'
  svg.appendChild(txt)
}

function showDashboard(){
  var state=XS.getState(),day=XS.getDay()
  var phaseNames={0:'动机接通',1:'习惯洞察',2:'习惯洞察',3:'习惯洞察',4:'替代构建',5:'替代构建',6:'替代构建',7:'替代构建',8:'挑战周',9:'挑战周',10:'挑战周',11:'挑战周',12:'挑战周',13:'挑战周',14:'挑战周',15:'身份巩固',16:'身份巩固',17:'身份巩固',18:'身份巩固',19:'身份巩固',20:'身份巩固',21:'身份巩固'}
  var phase=phaseNames[day]||''
  if($('d-day-phase'))$('d-day-phase').textContent='第 '+(day+1)+' 天 · '+phase
  var streak=0
  for(var i=0;i<state.checkins.length;i++){if(state.checkins[i].success)streak++}
  if($('d-streak'))$('d-streak').textContent=streak
  var trigs=state.triggers||[]
  if($('d-triggers-count'))$('d-triggers-count').textContent=trigs.length+' 个'
  var fm={smoke:'🚬烟',alcohol:'🍺酒',video:'📱手机',all:'全部'}
  if($('d-focus-display'))$('d-focus-display').textContent=state.focus?fm[state.focus]||state.focus:'—'
  var id=state.identityLevel||0
  var idt=['','我是在乎自己的人','我是对家人负责的人','我是掌控自己人生的人']
  var idb=['','🟢 Lv.1','🟡 Lv.2','🔴 Lv.3']
  if(id>0&&$('d-identity')){$('d-identity').style.display='block';if($('d-identity-text'))$('d-identity-text').textContent=idb[id]+' '+idt[id]}
  else if($('d-identity'))$('d-identity').style.display='none'
  var pct=Math.round((day/21)*100)
  if($('d-progress-bar'))$('d-progress-bar').style.width=Math.min(pct,100)+'%'
  if($('d-progress-text'))$('d-progress-text').textContent='第 '+(day+1)+' 天 / 21'
  if($('d-session-btn'))$('d-session-btn').textContent=day<=21?'📋 第 '+(day+1)+' 天练习':'🎉 重新开始'
  // Motd
  var msgs=['🌱 第一步是最难的一步，你已经迈出去了。','💪 改变不是一蹴而就的，是一天一天的坚持。','🌟 每一个"不"的背后，都是对自己的一个"是"。']
  if($('d-motd'))$('d-motd').textContent=msgs[day%msgs.length]
  renderTree(day+1)
}

// ─── SETTINGS ───
function showSettings(){
  var state=XS.getState()
  if($('s-progress'))$('s-progress').textContent='第 '+(state.day||0)+' 天'
  if($('s-tts-toggle')){
    $('s-tts-toggle').textContent=state.ttsEnabled!==false?'开启':'关闭'
    $('s-tts-toggle').classList.toggle('active',state.ttsEnabled!==false)
  }
  if($('s-guardian-btn')){
    $('s-guardian-btn').textContent=state.guardianName?state.guardianName:'设置'
  }
}

// ─── NOTIFICATIONS ───
function scheduleNotifications(){
  if(!('Notification' in window)||!('serviceWorker' in navigator)) return
  Notification.requestPermission().then(function(perm){
    if(perm!=='granted') return
    var slots=[
      {id:'morning',time:'07:00',text:'🌅 早上好！新的一天，新的开始。打开新生，看看今天的挑战。'},
      {id:'midday',time:'12:00',text:'☀️ 中午了！记得今天的挑战是什么吗？现在就可以做。'},
      {id:'afternoon',time:'17:00',text:'⚠️ 高危时段到了！先深呼吸3次，再做选择。'},
      {id:'evening',time:'21:00',text:'🌙 今天的挑战完成了吗？打开新生，做个报告吧。'}
    ]
    slots.forEach(function(slot){
      var now=new Date()
      var target=new Date()
      target.setHours(parseInt(slot.time),parseInt(slot.time.split(':')[1]),0,0)
      var delay=target-now
      if(delay<0) delay+=86400000
      setTimeout(function(){
        navigator.serviceWorker.ready.then(function(reg){
          reg.showNotification('🌱 新生',{
            body:slot.text,
            icon:'/xinsheng/icon.svg',
            tag:'xsheng-'+slot.id,
            data:{view:'chat'},
            requireInteraction:true
          })
        })
      },delay)
    })
  })
}

