    challenge: '对自己说："我是一个对自己负责的人。" 照镜子说，或者在心里说。然后——把这个消息告诉一个你爱的人。可以发一条消息，可以打个电话，可以说："我做到了。" 三个字就够了。今天是你新生的第一天。',
    report: {
      question: '今天是最后一天，你对自己说了那句话吗？',
      options: [
        { text: '✅ 说了！我是一个对自己负责的人', next: 'good', effect: 'XS.addCheckin({success:true, day:21}); XS.complete()' },
        { text: '😊 在心里说了', next: 'ok', effect: 'XS.addCheckin({success:true, day:21}); XS.complete()' },
        { text: '😅 说不出口，但心里认同', next: 'miss', effect: 'XS.addCheckin({success:false, day:21})' }
      ]
    },
    followups: {
      good: {
        coach: '（休息片刻）……你说出了那句话——"我是一个对自己负责的人"。你知道吗——从你说出这句话的那一刻起，你就不再是21天前的你了。你完成了21天的旅程，但更重要的是——你成为了一个"能够完成一件事"的人。这21天不长，但足以证明一件事：只要你想，你就能。你的家人——他们可能看到了你的变化。你咳嗽少了，你脾气好了，你陪他们的时间多了。即使你没跟他们说，他们也能感觉到——你不一样了。因为他们熟悉的那个"你"，正在变成更好的"你"。你现在要做的不是"继续保持"——是"继续生长"。就像一棵树——春天发了芽，夏天会茂盛，秋天会结果，冬天会休息。你会经历起起伏伏，但你的根——那个"对自己负责"的根——已经扎下去了。祝贺你，老哥/老姐。你做到了。',
        options: []
      },
      ok: {
        coach: '在心里说了——那也够了。因为说给自己听，比说给别人听更重要。你心里已经种下了那句话。以后每天早上起来，在心里对自己说一遍："我是一个对自己负责的人。" 说久了，它就变成了真的。这21天，你不是在"戒掉什么"——你是在"成为什么"。你成为了一个可以坚持21天的人。你成为了一个了解自己习惯的人。你成为了一个知道"替代比对抗更有用"的人。这些知识和经验，比你少抽几根烟重要一万倍。它们是你以后人生的武器。任何时候你觉得自己又要回到老路上了——拿出来用。你走过的路，不会白走。你已经成为更好的人了。我为你骄傲。',
        options: []
      },
      miss: {
        coach: '说不出口？那就不说——做出来。你今天做了一件对自己负责的事——你完成了21天的计划。你说不出口的话，你的行动已经替你说了。21天前你开始的时候，可能只是抱着"试试看"的心态。现在你走完了。这就是最大的"对自己负责"。说不说出来不重要——做出来了，才是真的。如果你以后准备好了，对着镜子说一次。也许明天、也许下周、也许一个月后——你准备好了，就说。不着急。你已经走了21天，你已经不是原来的你了。你的行动已经告诉了全世界。现在——去告诉你爱的人吧。三个字就够了："我做到了。"',
        options: []
      }
    }
  };

  function getDaily(day) {
    if (day === 0) return S0;
    return DAYS[day] || null;
  }

  return {
    S0: S0,
    DAYS: DAYS,
    getDaily: getDaily,
    totalDays: 21
  };
})();


// ═══════════════════════════════════════
// ENGINE
// ═══════════════════════════════════════
(function(){
var $=function(id){return document.getElementById(id)}
var P=window.PROTO
var ttsEnabled=XS.getState().ttsEnabled!==false
var isSpeaking=false

// ─── TTS ───
function speak(text){
  if(!ttsEnabled||!('speechSynthesis' in window)) return
  if(isSpeaking){window.speechSynthesis.cancel()}
  isSpeaking=true
  var u=new SpeechSynthesisUtterance(text)
  u.lang='zh-CN'
  u.rate=0.85
  u.pitch=1.0
  u.volume=1.0
  u.onend=function(){isSpeaking=false}
  window.speechSynthesis.speak(u)
}

function addSpeakButton(text){
  var sb=document.createElement('button')
  sb.className='speak-btn'
  sb.textContent='🔊'
  sb.onclick=function(e){e.stopPropagation();speak(text)}
  return sb
}

function setTTSState(enabled){
  ttsEnabled=enabled
  XS.setTTS(enabled)
  var btn=$('tts-btn')
  if(btn) btn.textContent=enabled?'🔊':'🔇'
  btn.classList.toggle('active',enabled)
  var sbtn=$('s-tts-toggle')
  if(sbtn) sbtn.textContent=enabled?'开启':'关闭'
}

// ─── VIEW SWITCHING ───
function switchView(name){
  var pages=['page-chat','page-emergency','page-dashboard','page-settings']
  pages.forEach(function(p){var el=$(p);if(el)el.classList.remove('active')})
  var target='page-'+name
  var el=$(target)
  if(el) el.classList.add('active')
  var navs=document.querySelectorAll('.nav-btn')
  for(var i=0;i<navs.length;i++){
    navs[i].classList.toggle('active',navs[i].dataset.page===target)
  }
  if(name==='chat') startDaily()
  if(name==='emergency') showEmergency()
  if(name==='dashboard') showDashboard()
  if(name==='settings') showSettings()
}

// ─── DAILY SESSION ───
var conversationNodes=[],nodeMap={},isS0Mode=false

function startDaily(){
  var state=XS.getState()
  var day=XS.getDay()
  var chat=$('chat-messages')
  chat.innerHTML=''

  if(!state.onboardingComplete){
    // S0 onboarding (regardless of day)
    isS0Mode=true
    if(P && P.S0 && P.S0.length){
      conversationNodes=P.S0
      nodeMap={}
      for(var i=0;i<conversationNodes.length;i++){
        if(conversationNodes[i]&&conversationNodes[i].id) nodeMap[conversationNodes[i].id]=conversationNodes[i]
      }
      var resumeId=state.currentNodeId
      var startNode=resumeId&&nodeMap[resumeId]?nodeMap[resumeId]:conversationNodes[0]
      if(startNode) showNode(startNode)
    }
    return
  }

  // Challenge mode (days 1-21)
  isS0Mode=false
  if(!P||!P.DAYS) return
  // If onboarding just completed, use current day
  var dayData=P.DAYS[day]
  if(!dayData){
    showEnd('所有练习已完成！去看看你的成长记录吧。')
    return
  }

  var phase=dayData.phase||''
  var title=dayData.title||''
  var greeting=dayData.greeting||''
  var challenge=dayData.challenge||''

  // Show phase tag
  var tag=document.createElement('div')
  tag.className='phase-tag'
  tag.textContent=phase
  chat.appendChild(tag)

  // Show greeting
  var m=document.createElement('div')
  m.className='msg coach'
  var parts=greeting.split('\n\n')
  var html=''
  for(var i=0;i<parts.length;i++) html+='<p>'+parts[i].replace(/\n/g,'<br>')+'</p>'
  if(ttsEnabled) html+='<span class="speak-wrapper"></span>'
  m.innerHTML=html
  chat.appendChild(m)
  var sw=m.querySelector('.speak-wrapper')
  if(sw) sw.appendChild(addSpeakButton(greeting))

  // Auto speak
  if(ttsEnabled) speak(greeting)

  // Show challenge card
  setTimeout(function(){
    var cc=document.createElement('div')
    cc.className='challenge-card'
    cc.innerHTML='<div class="challenge-title">🎯 今日挑战</div><div class="challenge-text">'+challenge.replace(/\n/g,'<br>')+'</div>'
    chat.appendChild(cc)
    chat.scrollTop=chat.scrollHeight

    // If already reported today, show done state
    if(XS.isReportDone(day)){
      showReportDone(day)
      return
    }

    setTimeout(function(){
      var q=document.createElement('div')
      q.className='msg coach'
      q.innerHTML='<p>'+dayData.report.question+'</p>'
      chat.appendChild(q)

      setTimeout(function(){
        var c=document.createElement('div')
        c.className='options-container'
        dayData.report.options.forEach(function(opt){
          var b=document.createElement('button')
          b.className='option-btn report-btn'
          b.textContent=opt.text
          b.onclick=function(){
            var btns=c.querySelectorAll('.option-btn')
            for(var j=0;j<btns.length;j++){btns[j].disabled=true}
            var u=document.createElement('div');u.className='msg user';u.textContent=opt.text;chat.appendChild(u)
            chat.scrollTop=chat.scrollHeight
            // Execute effect
            if(opt.effect){
              try{
                var fn=new Function('XS','day','return ('+opt.effect+')')
                fn(XS, day)
              }catch(e){}
            }
            XS.markReportDone(day)
            // Show followup
            var key=opt.next||'good'
            var followup=dayData.followups&&dayData.followups[key]?dayData.followups[key]:null
            if(followup){
              setTimeout(function(){showFollowup(followup, day)},500)
            } else {
              setTimeout(function(){showEnd('今天的练习完成了。明天继续！')},500)
            }
          }
          c.appendChild(b)
        })
        chat.appendChild(c)
        chat.scrollTop=chat.scrollHeight
      },400)
    },600)
  },1000)
}

function showReportDone(day){
  var chat=$('chat-messages')
  var d=document.createElement('div')
  d.className='msg coach'
  d.innerHTML='<p style="color:var(--gold);text-align:center;font-weight:500">✅ 今天的报告已提交。</p><p style="text-align:center;font-size:.8rem;color:var(--dim)">辛苦了，明天继续！</p>'
  chat.appendChild(d)
  var b=document.createElement('button')
  b.className='btn-second'
  b.textContent='🌱 查看成长'
  b.onclick=function(){switchView('dashboard')}
  chat.appendChild(b)
  chat.scrollTop=chat.scrollHeight
}

function showFollowup(followup, day){
  var chat=$('chat-messages')
  if(!followup||!followup.coach) return
  var m=document.createElement('div')
  m.className='msg coach'
  var parts=followup.coach.split('\n\n')
  var html=''
  for(var i=0;i<parts.length;i++) html+='<p>'+parts[i].replace(/\n/g,'<br>')+'</p>'
  m.innerHTML=html
  chat.appendChild(m)
  chat.scrollTop=chat.scrollHeight
  if(ttsEnabled) speak(followup.coach)

  setTimeout(function(){
    if(followup.options&&followup.options.length){
      var c=document.createElement('div')
      c.className='options-container'
      followup.options.forEach(function(opt){
        var b=document.createElement('button')
        b.className='option-btn'
        b.textContent=opt.text
        b.onclick=function(){
          var btns=c.querySelectorAll('.option-btn')
          for(var j=0;j<btns.length;j++){btns[j].disabled=true}
          var u=document.createElement('div');u.className='msg user';u.textContent=opt.text;chat.appendChild(u)
          if(opt.next) setTimeout(function(){
            var nextNode=nodeMap[opt.next]
            if(nextNode) showNode(nextNode)
            else showEnd('今天的练习完成了。')
          },500)
        }
        c.appendChild(b)
      })
      chat.appendChild(c)
      chat.scrollTop=chat.scrollHeight
    } else {
      setTimeout(function(){showEnd('今天的练习完成了。明天继续！')},500)
    }
  },400)
}

// ─── S0 CONVERSATION NODE ───
function showNode(node){
  if(!node) return
  XS.setSessionState('onboarding',node.id)
  var chat=$('chat-messages')
  var dots=document.createElement('div')
  dots.className='typing-indicator'
  dots.innerHTML='<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>'
  chat.appendChild(dots)
  chat.scrollTop=chat.scrollHeight
  var delay=Math.max(500,Math.min(2500,(node.coach||'').length*20))
  setTimeout(function(){
    if(dots.parentNode) dots.remove()
    var m=document.createElement('div')
    m.className='msg coach'
    var parts=(node.coach||'').split('\n\n')
    var html=''
    for(var i=0;i<parts.length;i++) html+='<p>'+parts[i].replace(/\n/g,'<br>')+'</p>'
    if(ttsEnabled && node.coach){
      html+='<span class="speak-wrapper"></span>'
    }
    m.innerHTML=html
    chat.appendChild(m)
    var sw=m.querySelector('.speak-wrapper')
    if(sw && node.coach) sw.appendChild(addSpeakButton(node.coach))
    chat.scrollTop=chat.scrollHeight
    if(ttsEnabled && node.coach) speak(node.coach)
    setTimeout(function(){
      if(node.options&&node.options.length) showOptions(node.options)
      else showEnd('今天我们先聊到这里。明天继续！', true)
    },400)
  },delay)
}

function showOptions(opts){
  var chat=$('chat-messages')
  if(!chat) return
  var c=document.createElement('div')
  c.className='options-container'
  opts.forEach(function(opt){
    var b=document.createElement('button')
    b.className='option-btn'
    b.textContent=opt.text
    b.onclick=function(){
      var btns=c.querySelectorAll('.option-btn')
      for(var j=0;j<btns.length;j++){btns[j].disabled=true}
      var u=document.createElement('div');u.className='msg user';u.textContent=opt.text;chat.appendChild(u)
      chat.scrollTop=chat.scrollHeight
      if(opt.effect) try{opt.effect()}catch(e){}
      if(opt.next&&nodeMap[opt.next]){
        setTimeout(function(){showNode(nodeMap[opt.next])},500)
      } else {
        setTimeout(function(){showEnd('今天我们先聊到这里。明天继续！', true)},500)
      }
    }
    c.appendChild(b)
  })
  chat.appendChild(c)
  chat.scrollTop=chat.scrollHeight
}

function showEnd(msg, isS0){
  var chat=$('chat-messages')
  if(!chat) return
  var m=document.createElement('div')
  m.className='msg coach'
  var text=msg||'今天就到这里。记住：你不需要一次性改变所有事情。只需要迈出最小的一步。'
  m.innerHTML='<p style="color:var(--gold);text-align:center;font-weight:500">'+text.replace(/\n/g,'<br>')+'</p>'
  chat.appendChild(m)
  var b=document.createElement('button')
  b.className='btn-primary'
  b.textContent='🌱 查看成长'
  b.onclick=function(){switchView('dashboard')}
  chat.appendChild(b)
  if(isS0){
    XS.setOnboardingDone()
    XS.completeSession(0)
  }
  chat.scrollTop=chat.scrollHeight
}

