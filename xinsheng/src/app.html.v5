<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>新生 — 21天改变计划</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{--bg:#1a1d23;--surface:#242830;--surface2:#2d313a;--accent:#4ecdc4;--accent2:#ff6b6b;--gold:#ffd93d;--green:#5cb85c;--text:#e8eaed;--dim:#8a8f9a;--muted:#555a64;--radius:14px}
html{font-size:18px}body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans SC","Helvetica Neue",sans-serif;background:var(--bg);color:var(--text);line-height:1.8;overflow-x:hidden;font-size:.95rem}
.page{display:none!important}.page.active{display:block!important}

/* HEADER */
.app-header{display:flex;align-items:center;justify-content:space-between;padding:.4rem .8rem;background:var(--surface);border-bottom:1px solid var(--muted);position:sticky;top:0;z-index:10;min-height:52px}
.header-left{display:flex;align-items:center;gap:.4rem}
.header-icon{font-size:1.4rem}.header-title{font-weight:700;font-size:1rem;color:var(--accent)}
.header-badge{background:var(--accent2);color:#fff;font-size:.6rem;padding:.12rem .4rem;border-radius:99px;font-weight:600}
.header-action{background:var(--surface2);border:1px solid var(--muted);color:var(--accent2);font-size:1rem;cursor:pointer;padding:.3rem .6rem;border-radius:8px;font-family:inherit}
.header-action:active{opacity:.7}
.tts-toggle{background:none;border:none;color:var(--dim);font-size:1.1rem;cursor:pointer;padding:.2rem .4rem;font-family:inherit}
.tts-toggle.active{color:var(--accent)}

/* CHAT VIEW */
#page-chat.active{display:flex!important;flex-direction:column;height:calc(100vh - 52px - 48px)}
#chat-messages{flex:1;overflow-y:auto;padding:.4rem .6rem .6rem;display:flex;flex-direction:column;gap:.3rem}
.msg{max-width:92%;padding:.7rem 1rem;border-radius:14px;animation:fadeUp .25s ease;font-size:.88rem;line-height:1.7}
.msg.coach{background:var(--surface);color:var(--text);align-self:flex-start;border-bottom-left-radius:4px;position:relative}
.msg.user{background:var(--accent);color:#1a1d23;align-self:flex-end;border-bottom-right-radius:4px;font-weight:500}
.msg p{margin-bottom:.3rem}.msg p:last-child{margin-bottom:0}
.msg-time{font-size:.6rem;color:var(--dim);margin-top:.3rem;display:block}
.speak-btn{background:none;border:none;color:var(--accent);font-size:.85rem;cursor:pointer;padding:.1rem;margin-left:.3rem;vertical-align:middle;font-family:inherit}
.speak-btn:active{opacity:.5}
@keyframes fadeUp{0%{opacity:0;transform:translateY(6px)}100%{opacity:1;transform:translateY(0)}}
.typing-indicator{align-self:flex-start;display:flex;gap:5px;padding:.6rem .85rem;background:var(--surface);border-radius:12px;border-bottom-left-radius:4px}
.typing-dot{width:8px;height:8px;border-radius:50%;background:var(--muted);animation:bounce 1.4s infinite ease-in-out}
.typing-dot:nth-child(2){animation-delay:.2s}.typing-dot:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}
.options-container{display:flex;flex-direction:column;gap:.35rem;margin-top:.1rem;animation:fadeUp .25s ease}
.option-btn{background:var(--surface2);color:var(--text);border:1px solid var(--muted);border-radius:12px;padding:.75rem .9rem;font-size:.88rem;cursor:pointer;text-align:left;transition:all .1s;font-family:inherit;line-height:1.4;min-height:48px}
.option-btn:active{background:var(--accent);color:#1a1d23;border-color:var(--accent);transform:scale(.97)}
.option-btn:disabled{cursor:default;opacity:.3}
.option-btn.report-btn{text-align:center;font-size:.9rem;font-weight:500}
.option-btn.report-btn.ok{background:var(--green);color:#fff;border-color:var(--green)}
.option-btn.report-btn.tried{background:#f0ad4e;color:#fff;border-color:#f0ad4e}
.option-btn.report-btn.fail{background:var(--muted);color:var(--dim);border-color:var(--muted)}
.chat-empty{text-align:center;padding:1.5rem;color:var(--dim);font-size:.85rem;line-height:1.6}
.challenge-card{background:linear-gradient(135deg,var(--surface),#1a2a28);border:1px solid var(--accent);border-radius:var(--radius);padding:.8rem;margin:.3rem 0;position:relative}
.challenge-title{font-size:.7rem;color:var(--accent);font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:.2rem}
.challenge-text{font-size:.9rem;color:var(--text);line-height:1.5}
.challenge-duration{font-size:.7rem;color:var(--dim);margin-top:.3rem}
.phase-tag{display:inline-block;background:var(--surface2);color:var(--dim);font-size:.65rem;padding:.1rem .5rem;border-radius:99px;margin-bottom:.3rem}

/* EMERGENCY */
#page-emergency.active{display:flex!important;flex-direction:column;min-height:calc(100vh - 52px - 48px)}
.emerg-container{flex:1;padding:.6rem;display:flex;flex-direction:column;gap:.5rem}
.emerg-title{text-align:center;font-size:1.1rem;font-weight:600;color:var(--accent);padding:.4rem 0}
.emerg-sub{text-align:center;color:var(--dim);font-size:.8rem;margin-bottom:.3rem}
.emerg-btn{display:flex;align-items:center;gap:.6rem;background:var(--surface);border:1px solid var(--muted);border-radius:var(--radius);padding:.9rem;font-size:.95rem;cursor:pointer;text-align:left;transition:all .1s;font-family:inherit;color:var(--text);line-height:1.4;min-height:60px}
.emerg-btn:active{transform:scale(.97);border-color:var(--accent);background:var(--surface2)}
.emerg-icon{font-size:1.8rem;flex-shrink:0}
.emerg-label{font-weight:600;font-size:.95rem}
.emerg-desc{font-size:.8rem;color:var(--dim);margin-top:.05rem}
.emerg-tier{font-size:.7rem;color:var(--gold);margin-top:.15rem}
.emerg-back{background:none;border:none;color:var(--muted);font-size:.85rem;padding:.5rem;cursor:pointer;text-align:center;font-family:inherit}
.emerg-step{margin:.5rem 0}

/* DASHBOARD */
.dash-header{text-align:center;padding:1rem .6rem .2rem}
.dash-title{font-size:1.2rem;color:var(--accent)}
.dash-sub{color:var(--dim);font-size:.8rem;margin-top:.1rem}
.card{background:var(--surface);border-radius:var(--radius);padding:.7rem .9rem;margin:.3rem .6rem}
.card-title{font-size:.75rem;color:var(--dim);margin-bottom:.25rem;font-weight:500}
.progress-track{height:8px;background:var(--surface2);border-radius:4px;overflow:hidden;margin:.3rem 0}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--gold));border-radius:4px;transition:width .5s ease}
.progress-text{font-size:.7rem;color:var(--dim);text-align:right}
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem}
.stat{text-align:center}
.stat-val{display:block;font-size:1.3rem;font-weight:700;color:var(--accent)}
.stat-lbl{font-size:.65rem;color:var(--dim)}
.identity-card{background:linear-gradient(135deg,var(--surface),#1a2a2a);border:1px solid var(--gold);text-align:center}
.identity-text{font-size:.95rem;font-weight:600;color:var(--gold)}
.motd{background:var(--surface);border-radius:var(--radius);padding:.7rem .9rem;margin:.3rem .6rem;border-left:3px solid var(--accent);font-size:.82rem;color:var(--dim);line-height:1.5}
.streak-fire{font-size:1.2rem;margin-right:.2rem}

/* SVG TREE */
.tree-container{display:flex;justify-content:center;padding:.5rem 0;margin:.3rem .6rem;background:var(--surface);border-radius:var(--radius)}
.tree-container svg{width:100%;max-width:200px;height:180px}

/* BUTTONS */
.btn-primary{display:block;width:calc(100% - 1.2rem);margin:.3rem .6rem;padding:.85rem;font-size:1rem;font-weight:700;background:var(--accent);color:#1a1d23;border:none;border-radius:var(--radius);cursor:pointer;text-align:center;min-height:50px;transition:transform .1s;font-family:inherit}
.btn-primary:active{transform:scale(.97)}
.btn-second{display:block;width:calc(100% - 1.2rem);margin:.25rem .6rem;padding:.75rem;font-size:.9rem;background:var(--surface2);color:var(--text);border:1px solid var(--muted);border-radius:var(--radius);cursor:pointer;text-align:center;font-family:inherit;min-height:48px}
.btn-link{display:block;width:100%;padding:.5rem;background:none;border:none;color:var(--muted);font-size:.75rem;cursor:pointer;text-align:center;font-family:inherit}

/* INSTALL BANNER */
.install-banner{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:2px solid var(--accent);padding:.5rem .8rem;z-index:200;display:none;animation:slideUp .3s ease;padding-bottom:env(safe-area-inset-bottom,.5rem)}
@keyframes slideUp{0%{transform:translateY(100%)}100%{transform:translateY(0)}}
.install-text{font-size:.8rem;color:var(--dim);margin-bottom:.35rem}
.install-row{display:flex;gap:.4rem}
.install-btn{flex:1;padding:.5rem;border:none;border-radius:8px;font-size:.8rem;font-weight:600;cursor:pointer;font-family:inherit}
.install-btn.accept{background:var(--accent);color:#1a1d23}
.install-btn.dismiss{background:var(--surface2);color:var(--dim)}

/* TOAST */
.toast{position:fixed;top:16px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.93);color:#fff;padding:.5rem 1rem;border-radius:8px;font-size:.85rem;z-index:999;animation:fadeOut 2.5s ease forwards;white-space:nowrap;text-align:center;pointer-events:none}
@keyframes fadeOut{0%{opacity:1}70%{opacity:1}100%{opacity:0}}

/* BOTTOM NAV */
#bottom-nav{position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--muted);display:flex;justify-content:space-around;padding:.15rem 0;padding-bottom:env(safe-area-inset-bottom,.15rem);z-index:100}
.nav-btn{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:.05rem;padding:.2rem .5rem;min-width:56px;font-family:inherit;color:var(--dim)}
.nav-icon{font-size:1.3rem}.nav-label{font-size:.55rem}
.nav-btn.active .nav-label{color:var(--accent);font-weight:600}

/* SETTINGS VIEW */
#page-settings.active{display:block!important;min-height:calc(100vh - 52px - 48px);padding:.6rem}
.settings-group{margin:.5rem 0}
.settings-label{font-size:.8rem;color:var(--dim);margin-bottom:.3rem}
.settings-desc{font-size:.75rem;color:var(--muted);margin-top:.2rem}
.settings-row{display:flex;align-items:center;justify-content:space-between;background:var(--surface);padding:.7rem .9rem;border-radius:var(--radius);margin:.25rem 0}
.settings-row-label{font-size:.88rem}
.toggle-btn{background:var(--surface2);border:1px solid var(--muted);border-radius:8px;padding:.35rem .7rem;font-size:.8rem;cursor:pointer;color:var(--text);font-family:inherit}
.toggle-btn.active{background:var(--accent);color:#1a1d23;border-color:var(--accent)}
.hidden{display:none!important}
</style>
</head>
<body>

<div class="app-header">
  <div class="header-left">
    <span class="header-icon">🌱</span>
    <span class="header-title">新生</span>
    <span class="header-badge" id="h-badge"></span>
  </div>
  <div style="display:flex;gap:.3rem;align-items:center">
    <button class="tts-toggle" id="tts-btn" title="语音朗读">🔊</button>
    <button class="header-action" id="h-action" title="紧急救援">🆘</button>
  </div>
</div>

<!-- CHAT -->
<div id="page-chat" class="page active">
  <div id="chat-messages"></div>
</div>

<!-- EMERGENCY -->
<div id="page-emergency" class="page">
  <div class="emerg-container" id="emerg-container"></div>
</div>

<!-- DASHBOARD -->
<div id="page-dashboard" class="page">
  <div class="dash-header">
    <h1 class="dash-title">🌱 新生</h1>
    <p class="dash-sub" id="d-day-phase"></p>
  </div>
  <div class="tree-container" id="tree-container"><svg id="growth-tree" viewBox="0 0 120 160" xmlns="http://www.w3.org/2000/svg"></svg></div>
  <div class="card">
    <p class="card-title">21天干预进程</p>
    <div class="progress-track"><div class="progress-fill" id="d-progress-bar" style="width:0%"></div></div>
    <p class="progress-text" id="d-progress-text">第 0 天 / 21</p>
  </div>
  <div class="card">
    <div class="stat-grid">
      <div class="stat"><span class="stat-val" id="d-streak">0</span><span class="stat-lbl">🔥 连续达成</span></div>
      <div class="stat"><span class="stat-val" id="d-triggers-count">0</span><span class="stat-lbl">触发识别</span></div>
      <div class="stat"><span class="stat-val" id="d-focus-display">—</span><span class="stat-lbl">当前专注</span></div>
    </div>
  </div>
  <div id="d-identity" class="card identity-card" style="display:none"><p class="identity-text" id="d-identity-text"></p></div>
  <div class="motd" id="d-motd">🌱 每天迈出一小步。打开对话，开始今天的练习。</div>
  <button id="d-session-btn" class="btn-primary">开始今天的练习</button>
  <button id="d-emergency-btn" class="btn-second">🆘 我现在需要帮助</button>
  <button id="d-settings-btn" class="btn-link">⚙️ 设置</button>
</div>

<!-- SETTINGS -->
<div id="page-settings" class="page">
  <div style="padding:.5rem .6rem">
    <div class="settings-group">
      <p class="settings-label">语音朗读</p>
      <div class="settings-row">
        <span class="settings-row-label">🔊 自动朗读对话</span>
        <button class="toggle-btn" id="s-tts-toggle">关闭</button>
      </div>
      <p class="settings-desc">开启后，每次收到消息会自动朗读</p>
    </div>
    <div class="settings-group">
      <p class="settings-label">守护人 (可选)</p>
      <div class="settings-row">
        <span class="settings-row-label">👤 设置守护人</span>
        <button class="toggle-btn" id="s-guardian-btn">设置</button>
      </div>
      <p class="settings-desc">守护人可以接收你的每日进展和紧急求助</p>
    </div>
    <div class="settings-group">
      <p class="settings-label">数据</p>
      <div class="settings-row">
        <span class="settings-row-label">📊 当前进度</span>
        <span style="color:var(--dim);font-size:.8rem" id="s-progress">第 0 天</span>
      </div>
      <button id="s-reset-btn" class="btn-link" style="color:var(--accent2);margin-top:.5rem">🗑️ 清除所有数据，重新开始</button>
    </div>
    <div style="text-align:center;margin-top:1rem;color:var(--muted);font-size:.7rem;line-height:1.6">
      新生 v5 — 21天行为改变计划<br>
      基于生态瞬时干预 (EMI) + 认知行为疗法 (CBT)<br>
      专为中国中老年朋友设计
    </div>
  </div>
</div>

<!-- NAV -->
<nav id="bottom-nav">
  <button class="nav-btn active" data-page="page-chat"><span class="nav-icon">💬</span><span class="nav-label">练习</span></button>
  <button class="nav-btn" data-page="page-emergency"><span class="nav-icon">🆘</span><span class="nav-label">救援</span></button>
  <button class="nav-btn" data-page="page-dashboard"><span class="nav-icon">🌱</span><span class="nav-label">成长</span></button>
</nav>

<!-- INSTALL BANNER -->
<div class="install-banner" id="install-banner">
  <p class="install-text">📌 添加到主屏幕，随时接收提醒</p>
  <div class="install-row">
    <button class="install-btn accept" id="install-accept">添加到主屏幕</button>
    <button class="install-btn dismiss" id="install-dismiss">稍后</button>
  </div>
</div>

<script>
// ═══════════════════════════════════════
// STORAGE LAYER
// ═══════════════════════════════════════
(function(){
var K='xsheng_v5'
function load(){
  try{
    var r=localStorage.getItem(K)
    if(r){var o=JSON.parse(r);if(o&&typeof o==='object')return o}
  }catch(e){}
  return{startDate:null,day:0,onboardingComplete:false,currentSession:'onboarding',currentNodeId:null,completed:false,protocolComplete:false,sessionsCompleted:[],values:null,readiness:null,triggers:[],alt:null,coping:null,focus:null,checkins:[],identityLevel:0,ttsEnabled:true,guardianName:null,guardianPhone:null,reportDone:{},createdAt:Date.now()}
}
function save(o){try{localStorage.setItem(K,JSON.stringify(o))}catch(e){}}
function getDay(){
  var o=load()
  if(!o.startDate){o.startDate=Date.now();o.day=0;save(o);return 0}
  var daysElapsed=Math.floor((Date.now()-o.startDate)/86400000)
  var d=Math.min(daysElapsed,21)
  if(d!==o.day){o.day=d;save(o)}
  return d
}
window.XS={
  getState:load, save:save, getDay:getDay,
  setSessionState:function(s,n){var o=load();o.currentSession=s;o.currentNodeId=n;save(o)},
  completeSession:function(id){var o=load();if(o.sessionsCompleted.indexOf(id)<0)o.sessionsCompleted.push(id);save(o)},
  markReportDone:function(day){var o=load();o.reportDone[day]=true;save(o)},
  isReportDone:function(day){var o=load();return !!o.reportDone[day]},
  setOnboardingDone:function(){var o=load();o.onboardingComplete=true;save(o)},
  scheduleNext:function(){
    var o=load(),c=o.sessionsCompleted.length
    if(c<=0)o.currentSession='onboarding'
    else if(c<=1)o.currentSession='cues'
    else if(c<=2)o.currentSession='planning'
    else o.currentSession='daily'
    o.currentNodeId=null;save(o)
  },
  setValue:function(v){var o=load();o.values=v;save(o)},
  setReadiness:function(r){var o=load();o.readiness=r;save(o)},
  addTrigger:function(t){var o=load();if(o.triggers.indexOf(t)<0)o.triggers.push(t);save(o)},
  setAlt:function(a){var o=load();o.alt=a;save(o)},
  setCoping:function(c){var o=load();o.coping=c;save(o)},
  setFocus:function(f){var o=load();o.focus=f;save(o)},
  addCheckin:function(e){var o=load();o.checkins.push(e);save(o)},
  setTTS:function(v){var o=load();o.ttsEnabled=v;save(o)},
  setGuardian:function(n,p){var o=load();o.guardianName=n;o.guardianPhone=p;save(o)},
  unlockIdentity:function(l){var o=load();if(l>(o.identityLevel||0))o.identityLevel=l;save(o)},
  completeProtocol:function(){var o=load();o.protocolComplete=true;o.completed=true;save(o)},
  reset:function(){try{localStorage.removeItem(K)}catch(e){}}
}
})();

// ═══════════════════════════════════════
// PROTOCOL CONTENT (inlined)
// ═══════════════════════════════════════
/**
 * 新生 (New Life) — 行为改变干预协议核心内容
 * 针对中国中老年用户，吸烟/酒精/短视频成瘾
 * 5阶段21天深度干预
 */
window.PROTO = (function () {
  var S0 = [
    // ====== 入口：生命故事开启 ======
    {
      id: 'start',
      coach: '你好，老哥/老姐。感谢你愿意花时间跟咱们聊聊。我不是医生，也不是老师，就是一个想帮你的朋友。在开始之前，我想先了解你这个人——不是你的习惯，是你这个人。你能给我讲讲你小时候的事吗？你是在哪儿长大的？',
      options: [
        { text: '🏠 农村长大，小时候苦', next: 'childhood_village' },
        { text: '🏙️ 城里长大，普普通通', next: 'childhood_city' },
        { text: '😐 不太想回忆小时候', next: 'childhood_reluctant' },
        { text: '🤔 你问这个干嘛？', next: 'why_ask' }
      ]
    },
    {
      id: 'why_ask',
      coach: '问这个，是因为我真心觉得——一个人现在的习惯，跟他走过的路是连着的。就像一棵树的根扎在哪儿，枝叶就往哪儿长。你年轻时吃过的苦、受过的累，可能养成了你今天的一些习惯。咱们不急着改什么，先一起看看你走过的路。你小时候在哪儿长大的？',
      options: [
        { text: '🏠 农村，小时候确实苦', next: 'childhood_village' },
        { text: '🏙️ 城里，还算平稳', next: 'childhood_city' },
        { text: '📖 行，那我简单说说', next: 'childhood_village' }
      ]
    },
    {
      id: 'childhood_reluctant',
      coach: '行，没事，不想说就不说。咱们换一个问法——你这一辈子，有没有那么一件事让你特别自豪的？不管是工作上的、家庭里的、还是别的什么。每个人心里都有一件得意的事。',
      options: [
        { text: '💪 把孩子培养成人', next: 'proud_child' },
        { text: '🏢 工作上做出过成绩', next: 'proud_work' },
        { text: '🧑‍🤝‍🧑 帮过别人，做了一件好事', next: 'proud_help' },
        { text: '😔 好像没什么自豪的事', next: 'proud_none' }
      ]
    },

    // ====== 童年分支 ======
    {
      id: 'childhood_village',
      coach: '农村长大的孩子，都知道什么叫"苦"。你小时候是不是也得下地干活？放学回来还要割猪草、挑水？可就是那样的日子，养出了咱们这代人最硬的骨头。你那时候最开心的事是什么？',
      options: [
        { text: '🎣 和小伙伴去河里摸鱼', next: 'village_fishing' },
